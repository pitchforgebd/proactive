# ---------------------------------------------------------------------------
# Copy to .env (git-ignored) and fill in. In production these are also set in
# the cPanel "Setup Node.js App" panel. See PHASE2-BACKEND.md §11.
# ---------------------------------------------------------------------------

# Canonical origin — metadata, Open Graph, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://proactive.com.bd

# --- Database (MySQL) ------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_proactive
DB_PASSWORD=
DB_NAME=cpaneluser_proactive

# --- Auth.js ---------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=https://proactive.com.bd

# --- Uploads ---------------------------------------------------------------
# MUST be a persistent directory OUTSIDE the build — public/ is replaced on
# every deploy and would wipe every upload (PHASE2-BACKEND.md §8).
UPLOAD_DIR=/home/cpaneluser/proactive-app/uploads

# --- Forms -----------------------------------------------------------------
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact
NEXT_PUBLIC_CAREER_ENDPOINT=/api/career

# --- Build target ----------------------------------------------------------
# Phase 2 is locked to Mode A (Node standalone on cPanel). Static export is
# retired: it cannot run route handlers, ISR, Server Actions or the database.
DEPLOY_MODE=node

# --- Optional email notification (nodemailer) ------------------------------
# Forms always save to the DB (admin inboxes). Mail is optional.
# Enable when ALL of HOST / USER / PASS are non-empty (cPanel Node env or .env).
# Never commit real passwords.
#
# Recipient priority (code in lib/mail.ts — do not reverse without a product decision):
#   1) Settings.email in /admin/settings
#   2) SMTP_TO
#   3) SMTP_USER
# From: SMTP_FROM → SMTP_USER → noreply@proactive.com.bd
#
# SMTP_HOST=mail.proactive.com.bd
# SMTP_PORT=465
# SMTP_USER=info@proactive.com.bd
# SMTP_PASS=
# SMTP_FROM=info@proactive.com.bd
# SMTP_TO=info@proactive.com.bd

# --- Admin seed (npm run db:seed) ------------------------------------------
# If ADMIN_PASSWORD is unset the seed generates one and prints it once.
ADMIN_EMAIL=admin@proactive.com.bd
ADMIN_PASSWORD=
