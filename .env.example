# Canonical origin — used for metadata, Open Graph, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://proactive.com.bd

# Data source. Phase 1 = mock fixtures. Phase 2 = the dashboard API.
#   mock   -> lib/data/mock/*
#   remote -> lib/data/remote.ts (requires NEXT_PUBLIC_API_BASE_URL)
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_BASE_URL=

# Where the forms post. Defaults suit Mode A (Node hosting).
# In Mode B (static export) point these at PHP handlers on the same cPanel.
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact
NEXT_PUBLIC_CAREER_ENDPOINT=/api/career

# Build target: node (Mode A, standalone server) or static (Mode B, ./out)
DEPLOY_MODE=node
